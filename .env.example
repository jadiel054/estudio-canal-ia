# Nunca adicione valores reais a este arquivo ou ao Git.
# Configure valores reais somente como variáveis criptografadas no cofre do ambiente.

# Neon Postgres exclusivo do Estúdio (usado somente pelo adaptador do estúdio)
STUDIO_DATABASE_URL=

# DATABASE_URL é reservado à camada de usuários Drizzle/MySQL do template.
# Não use aqui a URL PostgreSQL do Neon.
DATABASE_URL=

# Login próprio do Estúdio — nunca coloque a senha em texto; gere o hash com `pnpm auth:hash`
STUDIO_OWNER_EMAIL=
STUDIO_OWNER_PASSWORD_HASH=
STUDIO_SESSION_SECRET=

# OAuth YouTube — as rotas OAuth/upload reais ainda precisam ser implementadas
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# OAuth TikTok — opcional; as rotas OAuth/upload reais ainda precisam ser implementadas
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Provedor LLM externo opcional; o runtime Manus não é automaticamente transferido para Vercel
OPENAI_API_KEY=

# Provedores LLM da Etapa 2 — valores reais somente na Vercel
STUDIO_LLM_GEMINI_KEY=
STUDIO_LLM_GROQ_KEY=
